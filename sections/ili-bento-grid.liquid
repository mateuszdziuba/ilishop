{%- comment -%} sections/ili-bento-grid.liquid {%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style ili-bento"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="ili-bento-grid"
>
  {%- if section.settings.label != blank or section.settings.heading != blank -%}
    {%- render 'ili-heading', label: section.settings.label, heading: section.settings.heading, alignment: section.settings.heading_alignment | default: 'center' -%}
  {%- endif -%}

  <div class="ili-bento__grid" style="--bento-cols: {{ section.settings.columns | default: 4 }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col_span = block.settings.col_span | default: '1'
        assign row_span = block.settings.row_span
        assign custom_bg = block.settings.background_color
        assign custom_bg_style = ''
        if custom_bg != blank and custom_bg != 'rgba(0,0,0,0)'
          assign custom_bg_style = 'background:' | append: custom_bg | append: ';'
        endif
      -%}
      {%- case block.type -%}

        {%- when 'ili-bento-title' -%}
          <div
            class="ili-bento__item ili-bento__item--title ili-bento__item--col-{{ col_span }}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="ili-bento__item-link">{%- endif -%}
            <h3 class="ili-bento__card-heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>

        {%- when 'ili-bento-image' -%}
          <div
            class="ili-bento__item ili-bento__item--image ili-bento__item--col-{{ col_span }}{% if row_span %} ili-bento__item--row-2{% endif %}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="ili-bento__img-link">{%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'ili-bento__image', loading: 'lazy', alt: block.settings.image.alt, sizes: '(max-width: 749px) 50vw, 25vw' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'ili-bento__image ili-bento__placeholder' }}
            {%- endif -%}
            {%- if block.settings.image_caption != blank -%}
              <div class="ili-bento__image-caption">{{ block.settings.image_caption }}</div>
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>

        {%- when 'ili-bento-rating' -%}
          <div
            class="ili-bento__item ili-bento__item--rating ili-bento__item--col-{{ col_span }}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            <div class="ili-bento__stars">
              {%- assign star_count = block.settings.stars | default: 5 -%}
              {%- for i in (1..star_count) -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--ili-sage, #8B9E6E)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
            <p class="ili-bento__rating-value">{{ block.settings.rating_value }}</p>
            <p class="ili-bento__rating-label">{{ block.settings.rating_label }}</p>
          </div>

        {%- when 'ili-bento-text' -%}
          <div
            class="ili-bento__item ili-bento__item--text ili-bento__item--col-{{ col_span }}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.show_checkmark -%}
              <span class="ili-bento__checkmark" aria-hidden="true">&#10003;</span>
            {%- endif -%}
            <h4 class="ili-bento__card-subheading">{{ block.settings.heading }}</h4>
            {%- if block.settings.body != blank -%}
              <p class="ili-bento__card-body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="ili-bento__text-link">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>

        {%- when 'ili-bento-navy' -%}
          <div
            class="ili-bento__item ili-bento__item--navy ili-bento__item--col-{{ col_span }}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            <h4 class="ili-bento__card-heading">
              {{ block.settings.heading }}
              {%- if block.settings.heading_serif_part != blank -%}
                <em>{{ block.settings.heading_serif_part }}</em>
              {%- endif -%}
            </h4>
            <ul class="ili-bento__bullet-list">
              {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
              {%- if block.settings.bullet_4 != blank -%}<li>{{ block.settings.bullet_4 }}</li>{%- endif -%}
            </ul>
            {%- if block.settings.cta_label != blank -%}
              <a href="{{ block.settings.cta_url }}" class="ili-bento__cta-btn">{{ block.settings.cta_label }}</a>
            {%- endif -%}
          </div>

        {%- when 'ili-bento-cta' -%}
          <div
            class="ili-bento__item ili-bento__item--cta ili-bento__item--col-{{ col_span }}"
            style="{{ custom_bg_style }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.eyebrow != blank -%}
              <p class="ili-bento__cta-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h3 class="ili-bento__cta-heading">{{ block.settings.heading }}</h3>
            {%- if block.settings.body != blank -%}
              <p class="ili-bento__cta-body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <a href="{{ block.settings.cta_url }}" class="ili-bento__cta-btn ili-bento__cta-btn--light">{{ block.settings.cta_label }}</a>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ili-bento__grid {
    display: grid;
    grid-template-columns: repeat(var(--bento-cols, 4), 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .ili-bento__item {
    background: var(--ili-cream, #F5F3EF);
    border-radius: var(--ili-card-radius, 10px);
    padding: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .ili-bento__item:hover {
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.08);
    transform: translateY(-2px);
  }

  .ili-bento__item-link,
  .ili-bento__img-link {
    display: contents;
    color: inherit;
    text-decoration: none;
  }

  .ili-bento__card-heading {
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 400;
    color: var(--color-foreground-heading);
    margin: 0;
    line-height: 1.3;
  }

  .ili-bento__card-subheading {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-foreground-heading);
    margin: 0 0 8px;
  }

  .ili-bento__card-body {
    font-size: 14px;
    color: var(--ili-text-muted, #6B6B6B);
    line-height: 1.55;
    margin: 0;
  }

  .ili-bento__text-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-foreground-heading);
    text-decoration: none;
    margin-top: 16px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s ease;
  }

  .ili-bento__text-link:hover {
    opacity: 0.7;
  }

  .ili-bento__item--image {
    padding: 0;
    position: relative;
  }

  .ili-bento__image,
  .ili-bento__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--ili-card-radius, 10px);
    display: block;
    transition: transform 0.4s ease;
  }

  .ili-bento__item--image:hover .ili-bento__image {
    transform: scale(1.03);
  }

  .ili-bento__image-caption {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(0,0,0,0.45);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 6px 10px;
    border-radius: 6px;
    pointer-events: none;
  }

  .ili-bento__item--navy {
    background: var(--ili-navy, #1B2A4A);
    color: #fff;
  }

  .ili-bento__item--navy .ili-bento__card-heading {
    color: #fff;
  }

  .ili-bento__item--navy em {
    font-family: var(--font-heading--family);
    font-style: italic;
  }

  .ili-bento__bullet-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  .ili-bento__bullet-list li {
    padding: 6px 0 6px 20px;
    position: relative;
    opacity: 0.85;
    font-size: 14px;
    line-height: 1.4;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .ili-bento__bullet-list li:last-child {
    border-bottom: none;
  }

  .ili-bento__bullet-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--ili-sage, #8B9E6E);
  }

  .ili-bento__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    padding: 12px 24px;
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.4);
    border-radius: var(--ili-btn-radius, 4px);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .ili-bento__cta-btn:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.7);
  }

  .ili-bento__stars svg {
    display: inline-block;
    margin-right: 2px;
  }

  .ili-bento__rating-value {
    font-size: 28px;
    font-weight: 700;
    margin: 12px 0 4px;
    color: var(--color-foreground-heading);
    letter-spacing: -0.01em;
  }

  .ili-bento__rating-label {
    font-size: 13px;
    color: var(--ili-text-muted, #6B6B6B);
    margin: 0;
  }

  .ili-bento__checkmark {
    font-size: 28px;
    color: var(--ili-sage, #8B9E6E);
    margin-bottom: 8px;
    line-height: 1;
    display: block;
  }

  /* CTA card */
  .ili-bento__item--cta {
    background: var(--ili-navy, #1B2A4A);
    color: #fff;
  }

  .ili-bento__cta-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    margin: 0 0 12px;
  }

  .ili-bento__cta-heading {
    font-size: clamp(22px, 2.8vw, 32px);
    font-weight: 400;
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.25;
  }

  .ili-bento__cta-body {
    font-size: 14px;
    opacity: 0.8;
    line-height: 1.55;
    margin: 0;
  }

  .ili-bento__cta-btn--light {
    background: #fff;
    color: var(--ili-navy, #1B2A4A);
    border-color: #fff;
  }

  .ili-bento__cta-btn--light:hover {
    background: rgba(255,255,255,0.88);
    border-color: rgba(255,255,255,0.88);
  }

  /* Column span classes */
  .ili-bento__item--col-2 { grid-column: span 2; }
  .ili-bento__item--col-3 { grid-column: span 3; }
  .ili-bento__item--col-4 { grid-column: span 4; }
  .ili-bento__item--row-2 { grid-row: span 2; }

  @media screen and (max-width: 749px) {
    .ili-bento__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ili-bento__item--col-3,
    .ili-bento__item--col-4 {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 479px) {
    .ili-bento__grid {
      grid-template-columns: 1fr;
    }

    .ili-bento__item--col-2,
    .ili-bento__item--col-3,
    .ili-bento__item--col-4 {
      grid-column: span 1;
    }

    .ili-bento__item--row-2 {
      grid-row: span 1;
    }
  }
{% endstylesheet %}

