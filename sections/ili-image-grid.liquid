<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style ili-image-grid"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="ili-image-grid"
>
  <div class="ili-image-grid__header">
    <div class="ili-image-grid__heading">
      {% render 'ili-heading', label: section.settings.label, heading: section.settings.heading %}
    </div>
    {%- if section.settings.link_text != blank -%}
      <a href="{{ section.settings.link_url }}" class="ili-image-grid__link">
        {{ section.settings.link_text }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="ili-image-grid__grid ili-image-grid__grid--gap-{{ section.settings.gap }}">
    {%- comment -%} Each ili-image-grid-item block renders via blocks/ili-image-grid-item.liquid {%- endcomment -%}
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .ili-image-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .ili-image-grid__link {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .ili-image-grid__link:hover {
    opacity: 0.7;
  }

  .ili-image-grid__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }

  .ili-image-grid__grid--gap-none { gap: 0; }
  .ili-image-grid__grid--gap-small { gap: 4px; }
  .ili-image-grid__grid--gap-medium { gap: 12px; }
  .ili-image-grid__grid--gap-large { gap: 24px; }

  @media screen and (max-width: 749px) {
    .ili-image-grid__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 449px) {
    .ili-image-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ili Image Grid",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Follow us on Instagram"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "@ili"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Image gap",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small (4px)" },
        { "value": "medium", "label": "Medium (12px)" },
        { "value": "large", "label": "Large (24px)" }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "ili-image-grid-item",
      "name": "Image"
    }
  ],
  "presets": [
    {
      "name": "Ili Image Grid",
      "category": "Ili Editorial",
      "blocks": [
        { "type": "ili-image-grid-item" },
        { "type": "ili-image-grid-item" },
        { "type": "ili-image-grid-item" },
        { "type": "ili-image-grid-item" },
        { "type": "ili-image-grid-item" },
        { "type": "ili-image-grid-item" }
      ]
    }
  ]
}
{% endschema %}
