<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style ili-newsletter"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="ili-newsletter"
>
  <div class="ili-newsletter__inner ili-newsletter__inner--{{ section.settings.layout }}">
    <div class="ili-newsletter__content">
      {%- if section.settings.incentive != blank -%}
        <div class="ili-newsletter__incentive">{{ section.settings.incentive }}</div>
      {%- endif -%}
      {% render 'ili-heading', label: section.settings.label, heading: section.settings.heading, subtext: section.settings.subtext, heading_level: 'h2', alignment: section.settings.text_alignment, default: 'left' %}
      {%- comment -%} CRITICAL: Use 'customer' form, NOT 'contact' — native Shopify newsletter subscription {%- endcomment -%}
      {% form section.id %}
        {%- if form.posted_successfully? -%}
          <p class="ili-newsletter__success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            {{ section.settings.success_message | default: 'Thank you for subscribing!' }}
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="ili-newsletter__error">{{ form.errors.translated_fields['email'] | default: 'Please enter a valid email.' }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ili-newsletter__form">
            <input
              type="email"
              name="contact[email]"
              id="ili-newsletter-email-{{ section.id }}"
              placeholder="{{ section.settings.email_placeholder | default: 'Your email address' }}"
              required
              class="ili-newsletter__input"
              autocomplete="email"
            >
            <button type="submit" class="ili-newsletter__btn">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>
          {%- if section.settings.privacy_note != blank -%}
            <p class="ili-newsletter__privacy">{{ section.settings.privacy_note }}</p>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="ili-newsletter__image">
        {{ section.settings.image | image_url: width: 800 | image_tag: alt: section.settings.image.alt, loading: 'lazy', class: 'ili-newsletter__img' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ili-newsletter__inner {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .ili-newsletter__inner--side-by-side {
    grid-template-columns: 1fr 1fr;
  }

  .ili-newsletter__inner--centered {
    grid-template-columns: 1fr;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .ili-newsletter__incentive {
    display: inline-block;
    background: var(--ili-sage, #8B9E6E);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--ili-pill-radius, 9999px);
    margin-bottom: 20px;
  }

  .ili-newsletter__form {
    display: flex;
    gap: 0;
    margin-top: 24px;
    max-width: 440px;
  }

  .ili-newsletter__inner--centered .ili-newsletter__form {
    margin-left: auto;
    margin-right: auto;
  }

  .ili-newsletter__input {
    flex: 1;
    padding: 14px 20px;
    border: 1.5px solid var(--ili-border, #E8E4DF);
    border-right: none;
    border-radius: var(--ili-btn-radius, 4px) 0 0 var(--ili-btn-radius, 4px);
    font-size: 14px;
    outline: none;
    background: var(--color-background);
    color: var(--color-foreground);
    transition: border-color 0.2s ease;
  }

  .ili-newsletter__input:focus {
    border-color: var(--color-foreground);
  }

  .ili-newsletter__btn {
    padding: 14px 28px;
    background: var(--color-foreground-heading);
    color: var(--color-background);
    border: 1.5px solid var(--color-foreground-heading);
    border-radius: 0 var(--ili-btn-radius, 4px) var(--ili-btn-radius, 4px) 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ili-newsletter__btn:hover {
    opacity: 0.82;
  }

  .ili-newsletter__img {
    width: 100%;
    border-radius: var(--ili-card-radius, 10px);
    object-fit: cover;
    max-height: 440px;
  }

  .ili-newsletter__success {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ili-sage, #8B9E6E);
    font-weight: 500;
    margin-top: 20px;
    font-size: 15px;
  }

  .ili-newsletter__error {
    color: #c0392b;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .ili-newsletter__privacy {
    font-size: 12px;
    color: var(--ili-text-muted, #6B6B6B);
    margin-top: 12px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ili-newsletter__inner--side-by-side {
      grid-template-columns: 1fr;
    }

    .ili-newsletter__image {
      order: -1;
    }

    .ili-newsletter__form {
      flex-direction: column;
      max-width: 100%;
    }

    .ili-newsletter__input {
      border-right: 1.5px solid var(--ili-border, #E8E4DF);
      border-bottom: 0;
      border-radius: var(--ili-btn-radius, 4px) var(--ili-btn-radius, 4px) 0 0;
    }

    .ili-newsletter__btn {
      border-radius: 0 0 var(--ili-btn-radius, 4px) var(--ili-btn-radius, 4px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ili Newsletter",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "side-by-side", "label": "Side by side" },
        { "value": "centered", "label": "Centered" }
      ],
      "default": "side-by-side"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "incentive",
      "label": "Incentive badge",
      "info": "e.g. 'Get 10% off your first order'",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Updated, Stay Radiant"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get skincare tips, new arrivals, and exclusive offers delivered to your inbox."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    },
    {
      "type": "textarea",
      "id": "privacy_note",
      "label": "Privacy note",
      "default": "By subscribing you agree to receive marketing emails. Unsubscribe at any time."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Decorative image"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Ili Newsletter",
      "category": "Ili Editorial"
    }
  ]
}
{% endschema %}
