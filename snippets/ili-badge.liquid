{%- doc -%}
  Renders a Ili pill-shaped badge/tag.

  @param {string} text - Badge text (required)
  @param {string} url - Optional URL; wraps badge in an <a> tag when provided
  @param {string} variant - Badge variant: 'default', 'sale', 'new', 'sold-out' (default: 'default')
{%- enddoc -%}

{%- liquid
  assign badge_variant = variant | default: 'default'
-%}

{% if url != blank %}
  <a href="{{ url }}" class="ili-badge ili-badge--{{ badge_variant }}">{{ text }}</a>
{% else %}
  <span class="ili-badge ili-badge--{{ badge_variant }}">{{ text }}</span>
{% endif %}

{% stylesheet %}
  .ili-badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: var(--ili-pill-radius, 9999px);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    vertical-align: middle;
  }

  .ili-badge--default {
    background: var(--ili-badge-bg, #F0EDE8);
    color: var(--ili-text-primary, #1A1A1A);
  }

  .ili-badge--sale {
    background: #E8513A;
    color: #fff;
  }

  .ili-badge--new {
    background: var(--ili-sage, #8B9E6E);
    color: #fff;
  }

  .ili-badge--sold-out {
    background: var(--ili-text-muted, #6B6B6B);
    color: #fff;
  }
{% endstylesheet %}
